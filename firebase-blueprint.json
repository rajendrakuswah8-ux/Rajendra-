{
  "entities": {
    "GuardianUser": {
      "title": "GuardianUser",
      "description": "Authenticated parent or guardian account",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "PairingCode": {
      "title": "PairingCode",
      "description": "Ephemeral 6-digit pairing code generated by guardian",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 6, "minLength": 6 },
        "guardianId": { "type": "string" },
        "guardianEmail": { "type": "string" },
        "guardianName": { "type": "string" },
        "expiresAt": { "type": "number" },
        "isUsed": { "type": "boolean" },
        "usedByDeviceId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "guardianId", "expiresAt", "isUsed"]
    },
    "ChildDevice": {
      "title": "ChildDevice",
      "description": "Child device telemetry, presence, hardware status, and permissions",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "guardianId": { "type": "string" },
        "childName": { "type": "string" },
        "deviceModel": { "type": "string" },
        "batteryLevel": { "type": "number" },
        "isCharging": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "number" },
        "networkStatus": { "type": "string" },
        "flashlightState": { "type": "string" },
        "cameraStreaming": { "type": "boolean" },
        "audioStreaming": { "type": "boolean" },
        "screenStreaming": { "type": "boolean" },
        "permissions": { "type": "object" },
        "location": { "type": "object" },
        "screenTimeMinutes": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["deviceId", "guardianId", "childName"]
    },
    "DeviceCommand": {
      "title": "DeviceCommand",
      "description": "Remote control commands sent between Guardian and Child",
      "type": "object",
      "properties": {
        "commandId": { "type": "string" },
        "deviceId": { "type": "string" },
        "guardianId": { "type": "string" },
        "type": { "type": "string" },
        "payload": { "type": "object" },
        "status": { "type": "string" },
        "response": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["commandId", "deviceId", "guardianId", "type", "status"]
    },
    "DeviceEvent": {
      "title": "DeviceEvent",
      "description": "Audit and notification alerts for child device activity",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "deviceId": { "type": "string" },
        "guardianId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["eventId", "deviceId", "guardianId", "type", "title", "message", "timestamp"]
    }
  },
  "firestore": {
    "/guardians/{userId}": {
      "schema": "GuardianUser",
      "description": "Guardian parent profiles"
    },
    "/pairingCodes/{codeId}": {
      "schema": "PairingCode",
      "description": "Temporary 6-digit codes for device enrollment"
    },
    "/childDevices/{deviceId}": {
      "schema": "ChildDevice",
      "description": "Paired child devices state and telemetry"
    },
    "/deviceCommands/{commandId}": {
      "schema": "DeviceCommand",
      "description": "Remote commands sent to child devices"
    },
    "/deviceEvents/{eventId}": {
      "schema": "DeviceEvent",
      "description": "Notifications and security events"
    }
  }
}
